# Dental Demo Rig — environment. Copy to .env. Never commit .env.
# Synthetic data only. No PHI, no real patient information, ever.

# --- Claude: powers website -> PracticeProfile extraction only --------------
ANTHROPIC_API_KEY=sk-ant-...
EXTRACTION_MODEL=claude-opus-4-8

# --- Retell: the voice platform --------------------------------------------
RETELL_API_KEY=key_...
RETELL_API_BASE=https://api.retellai.com
# ElevenLabs voice, selected inside Retell. The first four seconds decide
# whether the prospect is listening critically or enjoying it.
RETELL_VOICE_ID=11labs-Adrian
RETELL_LLM_MODEL=gpt-4o
# Area code for provisioned demo numbers.
RETELL_AREA_CODE=312
# Where a red-flag transfer lands: a voicemail box the REP controls, so the
# prospect hears the handoff without a real phone ringing.
RETELL_TRANSFER_NUMBER=+13125550199

# --- Supabase: the demo calendar and call log ------------------------------
# Leave blank to run fully in-memory (no accounts needed, no live demo page).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Where Retell reaches the mock tools ------------------------------------
# Must be publicly reachable by Retell. Locally: `ngrok http 8000`.
WEBHOOK_BASE_URL=https://your-tunnel.ngrok.app

# --- Vercel: one branded demo page per prospect -----------------------------
VERCEL_TOKEN=
VERCEL_PROJECT=dental-demo
VERCEL_ORG_ID=
