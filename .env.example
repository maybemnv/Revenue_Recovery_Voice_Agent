# ---------------------------------------------------------------------------
# Revenue Recovery Voice Agent - environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
ENVIRONMENT=local                     # local | staging | production
LOG_LEVEL=INFO
# Public base URL of the API, used to build TwiML <Stream> and webhook URLs.
# Must be https/wss reachable by Twilio (use `ngrok http 8000` locally).
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# --- Datastores ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5432/voice
# Sync DSN used by Alembic and Celery workers.
DATABASE_URL_SYNC=postgresql+psycopg://voice:voice@localhost:5432/voice
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- OpenAI Realtime (media plane) ----------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
# Embeddings for the knowledge base (1536 dims, matches kb_chunks.embedding).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (post-call analysis) ---------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-5

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_FROM=+15551234567
# Set false only for local dev without a tunnel; must be true in production.
TWILIO_VALIDATE_SIGNATURES=true

# --- Cal.com ---------------------------------------------------------------
CALCOM_API_KEY=cal_live_...
CALCOM_API_BASE=https://api.cal.com/v2
CALCOM_EVENT_TYPE_ID=0

# --- HubSpot ---------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=pat-...
HUBSPOT_API_BASE=https://api.hubapi.com

# --- Stripe ----------------------------------------------------------------
STRIPE_API_KEY=sk_test_...
STRIPE_PRICE_ID=price_...

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Dashboard -------------------------------------------------------------
# Comma-separated allowed origins for CORS. Scope to the deployed dashboard.
CORS_ALLOW_ORIGINS=http://localhost:3000
# Shared secret for dashboard API auth; the web app sends it as a Bearer token.
DASHBOARD_API_TOKEN=change-me-in-production
DASHBOARD_VIEWER_TOKEN=change-me-viewer

# --- Web (apps/web) --------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_TOKEN=change-me-in-production
